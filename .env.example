# =============================================================================
# Laravel 12 + Livewire 4 — .env para Railway (Conexión Externa)
# =============================================================================

APP_NAME="Protejo Mi Mente"
APP_ENV=production
APP_KEY=base64:tSVtWBBFUOKrHtOMmgKf5diJWgrter5TaHRby+L9QQA=
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Base de Datos (Credenciales para Proyectos Separados)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql

# IMPORTANTE: Copia los valores reales de tu pestaña de Base de Datos en Railway
DB_HOST=tu-dominio-de-proxy.proxy.rlwy.net
DB_PORT=tu-puerto-de-5-digitos

DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=JqkKrfcFYWBOraxDrXJuMythMyNiACyN

# -----------------------------------------------------------------------------
# Drivers y Estabilidad
# -----------------------------------------------------------------------------
# Cambiamos a 'cookie' y 'file' para que la app no explote antes de las migraciones
SESSION_DRIVER=cookie
CACHE_STORE=file
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Otros Servicios
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"